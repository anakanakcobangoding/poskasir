# Menggunakan base image PHP resmi dengan Apache
FROM php:8.2-apache

# Install dependencies sistem & ekstensi PHP yang wajib untuk Laravel
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    zip \
    unzip \
    git \
    curl

# Install ekstensi PHP (termasuk pdo_mysql untuk koneksi ke database MySQL)
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd

# Install Composer (Package Manager PHP)
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Tentukan direktori kerja di dalam container
WORKDIR /var/www/html

# Salin seluruh file proyek ke dalam container
COPY . .

# Ubah document root Apache agar mengarah ke folder public Laravel
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf

# Aktifkan mod_rewrite Apache agar routing Laravel berjalan normal
RUN a2enmod rewrite

# Berikan hak akses (permissions) untuk folder storage dan cache
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

# Install package vendor via composer (tanpa file development)
RUN composer install --no-dev --optimize-autoloader

# Sesuaikan port Apache agar kompatibel dengan port dinamis Render
RUN sed -i 's/80/${PORT}/g' /etc/apache2/ports.conf /etc/apache2/sites-available/000-default.conf
